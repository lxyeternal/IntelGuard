{
  "_doc": "Slicing criteria: sensitive APIs in five categories (network, file, process, sysinfo, encryption). 'modules': every member of the module counts; 'members': specific dotted names; 'globals': bare builtins.",
  "python": {
    "modules": {
      "network": ["socket", "urllib", "urllib2", "urllib3", "requests", "http", "httplib", "ftplib", "dns", "ssl"],
      "file": ["shutil"],
      "process": ["subprocess", "threading", "multiprocessing", "signal"],
      "sysinfo": ["platform", "getpass"],
      "encryption": ["hashlib", "base64", "cryptography", "codecs", "zlib", "marshal"]
    },
    "members": {
      "process": ["os.system", "os.popen", "os.exec", "os.execl", "os.execv", "os.execve", "os.spawn", "os.spawnl", "os.fork", "os.startfile"],
      "file": ["os.remove", "os.unlink", "os.rename", "os.rmdir", "os.makedirs", "os.mkdir", "os.listdir", "os.walk", "os.chmod", "os.path.expanduser"],
      "sysinfo": ["os.environ", "os.getenv", "os.uname", "os.getlogin", "os.getcwd", "os.name", "sys.platform", "sys.argv", "sys.executable", "sys.version", "sys.modules", "sys.exit"]
    },
    "globals": {
      "process": ["eval", "exec", "compile", "__import__"],
      "file": ["open"]
    }
  },
  "javascript": {
    "modules": {
      "network": ["http", "https", "net", "dgram", "dns", "tls", "axios", "request", "node-fetch", "got"],
      "file": ["fs", "fs/promises"],
      "process": ["child_process", "cluster", "worker_threads", "vm"],
      "sysinfo": ["os"],
      "encryption": ["crypto", "zlib"]
    },
    "members": {
      "sysinfo": ["process.env", "process.argv", "process.platform", "process.cwd"],
      "encryption": ["Buffer.from"],
      "process": ["Function.constructor"]
    },
    "globals": {
      "process": ["eval", "Function", "require", "import"],
      "network": ["fetch", "XMLHttpRequest", "WebSocket"],
      "encryption": ["atob", "btoa"]
    }
  }
}
