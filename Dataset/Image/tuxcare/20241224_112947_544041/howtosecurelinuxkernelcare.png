<style id='weglot-css-inline-css'>
.menu-top-header-menu-container ul li {
  position: relative;
}
.menu-top-header-menu-container ul li ul.sub-menu {
  position: absolute;
  width: 125px;
  display: block;
  background: #fff;
  z-index: 999999;
  top: 39px;
  padding-bottom: 13px;
  left: -20px;
  opacity: 0;
  visibility: hidden;
}
.menu-top-header-menu-container ul li a {
  padding: 15px 0px;
}
.menu-top-header-menu-container ul li:hover ul.sub-menu {
  opacity: 1;
  visibility: visible;
}

</style>
